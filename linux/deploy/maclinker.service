# systemd user service: copy to ~/.config/systemd/user/ then `systemctl --user enable --now maclinker`
[Unit]
Description=MacLinker (share keyboard, mouse and clipboard with your Mac)
After=graphical-session.target network-online.target

[Service]
ExecStart=%h/.local/share/maclinker/venv/bin/maclinker run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
